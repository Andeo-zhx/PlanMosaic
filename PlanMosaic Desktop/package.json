{
  "name": "planmosaic",
  "version": "1.1.0",
  "description": "学业规划系统桌面应用",
  "main": "main.js",
  "bin": {
    "planmosaic": "./cli.js",
    "pm": "./cli.js"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "cli": "node cli.js",
    "cal": "node cli.js calendar",
    "config": "node cli.js config",
    "agent": "node cli.js agent",
    "backup": "node cli.js data backup",
    "test": "node cli.js test run",
    "ui": "node cli.js ui",
    "build": "electron-builder --win --x64"
  },
  "keywords": [
    "planner",
    "calendar",
    "schedule"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1"
  },
  "build": {
    "appId": "com.planmosaic.desktop",
    "productName": "PlanMosaic",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "paths.js",
      "ai-agent.js",
      "ai-tools.js",
      "package.json",
      "favicon.ico",
      "Image/**/*"
    ],
    "win": {
      "icon": "favicon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null
    },
    "portable": {
      "artifactName": "PlanMosaic${version}-Portable.exe"
    },
    "extraMetadata": {
      "env": {
        "NODE_ENV": "production"
      }
    },
    "extraResources": [
      {
        "from": "favicon.ico",
        "to": "favicon.ico"
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ]
  }
}
